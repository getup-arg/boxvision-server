# Copy this file to .env and fill in the values

PORT=5003

# Totem / desktop database
DB_TOTEM_HOST=190.105.227.203
DB_TOTEM_PORT=3306
DB_TOTEM_USER=
DB_TOTEM_PASSWORD=
DB_TOTEM_NAME=boxvisio_db

# JWT — use a long random string (at least 32 chars)
JWT_SECRET=

# MercadoPago — production access token from https://www.mercadopago.com.ar/developers/panel
# (rotate the previously-leaked one before deploying)
MP_ACCESS_TOKEN=

# Frontend base URL — used in MercadoPago back_urls and JWT iss/aud claims
FRONTEND_BASE=https://boxvision-c0bda.web.app

# Google Cloud Storage bucket where uploaded prescriptions go
# Must exist; the Cloud Run service account needs Storage Object Admin on it
RECETAS_BUCKET=
